{
  "version": "2.0.0",
  "tasks": [
    {
      // [Branch Switching Automation]:
      // Terminate any leftover/orphaned postgres processes from previously run branches
      // or aborted debug sessions so port 8090/5432 and unix socket locks are freed before launch.
      "label": "kill_stale_postgres",
      "type": "shell",
      "command": "powershell -Command \"Get-Process postgres -ErrorAction SilentlyContinue | Stop-Process -Force\"",
      "windows": {
        "command": "powershell -Command \"Get-Process postgres -ErrorAction SilentlyContinue | Stop-Process -Force\""
      },
      "osx": {
        "command": "pkill -f postgres 2>/dev/null || true"
      },
      "linux": {
        "command": "pkill -f postgres 2>/dev/null || true"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "serverpod_start",
      "type": "shell",
      "command": "serverpod",
      "args": ["start"],
      // Ensures stale background postgres instances from previous branches are killed before starting
      "dependsOn": ["kill_stale_postgres"],
      "options": {
        "cwd": "${workspaceFolder}/orderflow_server",
        "env": {
          "SERVERPOD_PASSWORD_database": "jh3FH3Ip8Tnio-WzJtLHwQZGevexjR69",
          // Marks a `serverpod start` launched from the IDE, which is the
          // only kind that honors the Flutter device picked in VS Code. A run
          // started from a plain terminal carries no marker, so a device file
          // left behind by a session that was killed cannot retarget it.
          "SERVERPOD_LAUNCHED_FROM_IDE": "true"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      // The TUI captures stdout, so we can't string-match for "ready". The
      // attach config polls vm-service-info.json for the actual readiness
      // signal; this matcher exists only to satisfy VS Code's requirement
      // that background tasks declare one. The pattern intentionally never
      // matches; begin/end patterns mark the task active+ready immediately.
      "problemMatcher": {
        "owner": "serverpod",
        "pattern": [
          {
            "regexp": "^(SERVERPOD_NEVER_MATCH):(\\d+):(.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      }
    }
  ]
}
